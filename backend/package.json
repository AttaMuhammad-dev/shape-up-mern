{
  "name": "shape-up-app",
  "version": "1.0.0",
  "description": "Shape Up App - Backend",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "server": "node --watch app.js",
    "client": "set HOST=0.0.0.0&& npm run start --prefix ../frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "test": "node --test tests/*.test.js",
    "vercel-build": "echo hello"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "8.7.1",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.2.1",
    "nodemailer": "^10.1.7"
  },
  "devDependencies": {
    "concurrently": "^8.0.1"
  }
}
